# Omit application images to build them from this checkout. Release deployments
# should set immutable tags or digests produced by CI.
# KANVAS_SERVER_IMAGE=registry.example.invalid/kanvas/server:0.1.0@sha256:replace-me
# KANVAS_WORKER_IMAGE=registry.example.invalid/kanvas/worker:0.1.0@sha256:replace-me
# KANVAS_WEB_IMAGE=registry.example.invalid/kanvas/web:0.1.0@sha256:replace-me
KANVAS_MYSQL_IMAGE=mysql:8.0.45@sha256:4af1f8815716546f5b12410f7621f37f93db8dd11a184706ef59111930b8c2ff
KANVAS_REDIS_IMAGE=redis:7.2.16-alpine@sha256:ccd6aa8d45ff3f033d6fa15b8cc1a50579f65c89f38cf9bb607a954c4f2128ed

KANVAS_INSTANCE_ID=replace-with-stable-instance-id
KANVAS_RELEASE_VERSION=0.0.0-development
KANVAS_DATABASE_NAME=kanvas
KANVAS_DATABASE_USER=kanvas
KANVAS_REDIS_DB=0
# Public origin only: HTTPS, no path/query/fragment.
KANVAS_AUTH_BASE_URL=https://kanvas.example.com
# Optional verified-email registration. Mount the SMTP password at
# ${KANVAS_SECRETS_DIR}/kanvas_smtp_password, then include
# deploy/compose.smtp.yaml when starting Compose.
# KANVAS_AUTH_EMAIL_SMTP_HOST=smtp.example.com
# KANVAS_AUTH_EMAIL_SMTP_PORT=587
# KANVAS_AUTH_EMAIL_SMTP_SECURE=false
# KANVAS_AUTH_EMAIL_SMTP_REQUIRE_TLS=true
# KANVAS_AUTH_EMAIL_SMTP_USER=kanvas
# KANVAS_AUTH_EMAIL_FROM_ADDRESS=kanvas@example.com
# KANVAS_AUTH_EMAIL_FROM_NAME=Kanvas
KANVAS_HTTP_PORT=8080
# Official Compose has exactly one Web reverse-proxy hop before Server.
KANVAS_HTTP_TRUSTED_PROXY_HOPS=1
# Set this to the actual proxy IP or dedicated proxy-network CIDR.
KANVAS_HTTP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
KANVAS_LOG_LEVEL=info
KANVAS_WORKER_STOP_GRACE_PERIOD=10m
KANVAS_SECRETS_DIR=./secrets
KANVAS_STORAGE_KIND=local
# Stable ULID generated once for this deployment. Never rotate it in place.
KANVAS_LOCAL_STORAGE_PROFILE_ID=01K00000000000000000000020
# Absolute host directory, pre-created as UID/GID 10001 with mode 0700.
KANVAS_LOCAL_STORAGE_HOST_ROOT=/srv/kanvas/objects
KANVAS_STORAGE_USER_IMPORT_TTL_MS=3600000
KANVAS_STORAGE_GC_POLL_INTERVAL_MS=5000
KANVAS_STORAGE_GC_CLAIM_LEASE_MS=30000
KANVAS_STORAGE_GC_BASE_RETRY_MS=5000
KANVAS_STORAGE_GC_MAX_RETRY_MS=300000
KANVAS_ARTIFACT_PREVIEW_MODE=on_demand
KANVAS_ARTIFACT_PREVIEW_FALLBACK_ON_MISS=true
KANVAS_ARTIFACT_PREVIEW_WORKER_CONCURRENCY=2
KANVAS_ARTIFACT_PREVIEW_GENERATION_ATTEMPTS=3
KANVAS_ARTIFACT_PREVIEW_GENERATION_RETRY_MS=5000

# Optional. Empty means no OTLP export; it must not prevent application startup.
OTEL_EXPORTER_OTLP_ENDPOINT=
