# Copy to deploy/.env (ignored by Git). Keep it out of image build layers.
# Use an immutable published image reference, or build the local image from source.
KANVAS_IMAGE=kanvas:local
# Optional published address/port default to 127.0.0.1:8080.
# The image defaults to production and instance identity kanvas.
# Keep an existing custom KANVAS_INSTANCE_ID unchanged when upgrading.
KANVAS_AUTH_BASE_URL=https://kanvas.example.com
# Replace with a persistent random secret of at least 32 characters.
KANVAS_AUTH_SECRET=
# Encode reserved characters in URL usernames/passwords. The database must exist.
# Add ?ssl=true for MySQL TLS. Use rediss:// for Redis TLS / named ACL accounts.
KANVAS_DATABASE_URL=mysql://kanvas:replace-me@mysql.example.com:3306/kanvas
KANVAS_REDIS_URL=redis://:replace-me@redis.example.com:6379/0
# The all command migrates automatically. For a separate release job, set
# KANVAS_DB_MIGRATION_MODE=check with a runtime-only database account.
# The standalone image uses its persistent objects volume by default.
# Existing custom storage settings and profile IDs must be retained on upgrade.
# For S3/OSS supply the complete selected backend settings; see CONFIGURATION.md.
# One internal Nginx hop is trusted by default. With one external reverse proxy:
# KANVAS_HTTP_TRUSTED_PROXY_HOPS=2
# KANVAS_HTTP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Provider execution / Agent policies and optional OIDC: see docs/CONFIGURATION.md.

# The standalone image supplies Worker roles and worker/provider execution targets.
# Installed HTTP adapters are available by default; an explicit adapter list narrows them.
# Optional additional restriction on the Provider API endpoints saved in Settings.
# KANVAS_PROVIDER_ALLOWED_ORIGINS=https://api.example.com
# Public HTTPS result downloads work by default; optional operator restrictions:
# KANVAS_PROVIDER_RESULT_DOWNLOADS_ENABLED=false
# KANVAS_PROVIDER_RESULT_ALLOWED_ORIGINS=https://results.example.com
# Optional encryption of newly stored Provider keys (persistent 32-byte KEK):
# KANVAS_PROVIDER_ACTIVE_KEK_VERSION=v1
# KANVAS_PROVIDER_KEK_MAP_JSON={"v1":"<base64-32-byte-key>"}
# Keep all existing KEK versions while encrypted records still refer to them.
# Password invitations/registration require SMTP when email verification is required.
# Configure SMTP using compose.smtp.yaml, or use an explicitly configured OIDC provider.
