{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "kanvas.image.resize.sharp.v1",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "画质增强 · Worker",
      "en-US": "Image upscale · Worker"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将画质增强的公开输入输出转换为Worker运行协议。",
      "en-US": "Adapts the public Image upscale contract to the Worker runtime protocol."
    }
  },
  "executionTarget": "worker",
  "sourceKinds": ["plugin"],
  "supportedModelFormats": [],
  "invocationInputSchema": {
    "$id": "kanvas.image-upscale-input.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["sourceArtifactId", "qualityIntent"],
    "properties": {
      "guidance": {
        "type": "string",
        "maxLength": 1000,
        "minLength": 1,
        "x-kanvas-semantic-type": "prompt.rich"
      },
      "scaleFactor": {
        "const": 2,
        "default": 2,
        "x-kanvas-semantic-type": "value.any"
      },
      "qualityIntent": {
        "enum": ["faithful", "reconstructive"],
        "type": "string",
        "x-kanvas-semantic-type": "text.plain"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.image"
      }
    },
    "additionalProperties": false
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-upscale-result.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "imageArtifactId",
      "qualityIntent",
      "scaleFactor",
      "sourceWidth",
      "sourceHeight",
      "outputWidth",
      "outputHeight",
      "qualitySignals"
    ],
    "properties": {
      "outputWidth": {
        "type": ["integer", "null"],
        "minimum": 1,
        "x-kanvas-semantic-type": "value.any"
      },
      "scaleFactor": {
        "const": 2,
        "x-kanvas-semantic-type": "value.any"
      },
      "sourceWidth": {
        "type": ["integer", "null"],
        "minimum": 1,
        "x-kanvas-semantic-type": "value.any"
      },
      "outputHeight": {
        "type": ["integer", "null"],
        "minimum": 1,
        "x-kanvas-semantic-type": "value.any"
      },
      "sourceHeight": {
        "type": ["integer", "null"],
        "minimum": 1,
        "x-kanvas-semantic-type": "value.any"
      },
      "qualityIntent": {
        "enum": ["faithful", "reconstructive"],
        "type": "string",
        "x-kanvas-semantic-type": "text.plain"
      },
      "schemaVersion": {
        "const": "kanvas.image-upscale-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "method",
          "generative",
          "resamplingKernel"
        ],
        "properties": {
          "method": {
            "enum": ["deterministic_resample", "generative_reconstruction"],
            "type": "string"
          },
          "generative": {
            "type": "boolean"
          },
          "schemaVersion": {
            "const": "kanvas.image-upscale-quality/v1"
          },
          "resamplingKernel": {
            "enum": ["lanczos3", null],
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      },
      "imageArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": {
            "const": "attempt-output-artifact/v1"
          },
          "outputRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.image"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "default": {
      "scaleFactor": 2,
      "outputFormat": "png",
      "sharpVersion": "0.35.3",
      "qualityIntent": "faithful",
      "resamplingKernel": "lanczos3",
      "maximumOutputPixels": 64000000,
      "maximumSourcePixels": 16000000
    },
    "const": {
      "scaleFactor": 2,
      "outputFormat": "png",
      "sharpVersion": "0.35.3",
      "qualityIntent": "faithful",
      "resamplingKernel": "lanczos3",
      "maximumOutputPixels": 64000000,
      "maximumSourcePixels": 16000000
    }
  },
  "artifactInputs": [
    {
      "role": "sourceArtifactId",
      "pointer": "/sourceArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.worker-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "kanvas.image.resize.sharp.v1",
    "releaseDigest": "sha256:c4c51b61a036016d7a93a58b04bcc0ee0cd1f526ce6bbdad0836df25ac042a4e"
  },
  "selectionPolicy": {
    "scope": "capability_private",
    "capabilityKey": "image.upscale"
  }
}
