{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "openai.image.object-remove.v1",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "物体移除 · OpenAI 模型服务",
      "en-US": "Object removal · OpenAI model service"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将物体移除公开接口转换为 OpenAI 图片编辑协议。",
      "en-US": "Adapts the public object-removal interface to the OpenAI image-edit protocol."
    }
  },
  "executionTarget": "provider",
  "sourceKinds": ["model_service"],
  "supportedModelFormats": [],
  "invocationInputSchema": {
    "$id": "kanvas.image-object-remove-input.v1",
    "type": "object",
    "oneOf": [{ "required": ["maskArtifactId"] }, { "required": ["regions"] }],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["sourceArtifactId"],
    "properties": {
      "regions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["points"],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number", "maximum": 16384, "minimum": 0 },
                  "y": { "type": "number", "maximum": 16384, "minimum": 0 }
                },
                "additionalProperties": false
              },
              "maxItems": 64,
              "minItems": 3
            }
          },
          "additionalProperties": false
        },
        "maxItems": 128,
        "minItems": 1,
        "x-kanvas-semantic-type": "region.list"
      },
      "guidance": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1,
        "x-kanvas-semantic-type": "prompt.rich"
      },
      "maskArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.mask"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.image"
      }
    },
    "additionalProperties": false,
    "x-kanvas-provider-parameter-keys": [
      "size",
      "quality",
      "outputFormat",
      "background",
      "outputCompression"
    ],
    "x-kanvas-provider-model-operation": "image.edit"
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-object-remove-adapter-result.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "repairedArtifactId",
      "removedRegionMaskArtifactId",
      "qualitySignals"
    ],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-object-remove-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "method",
          "generative",
          "outsideMaskPixelsPreserved",
          "removedPixelRatio"
        ],
        "properties": {
          "method": { "const": "generative_inpaint" },
          "generative": { "const": true },
          "schemaVersion": {
            "const": "kanvas.image-object-remove-quality/v1"
          },
          "removedPixelRatio": {
            "type": "number",
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0
          },
          "outsideMaskPixelsPreserved": { "const": true }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      },
      "repairedArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": { "const": "attempt-output-artifact/v1" },
          "outputRole": { "const": "repaired" },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.image"
      },
      "removedRegionMaskArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": { "const": "attempt-output-artifact/v1" },
          "outputRole": { "const": "removed_region_mask" },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.mask"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "default": {
      "protocol": "images.edits.v1",
      "operation": "image.object.remove",
      "dataEgress": "authorized_source_artifact",
      "outputMaterialization": "trusted_storage"
    },
    "const": {
      "protocol": "images.edits.v1",
      "operation": "image.object.remove",
      "dataEgress": "authorized_source_artifact",
      "outputMaterialization": "trusted_storage"
    }
  },
  "modelServiceSelector": {
    "operation": "image.edit",
    "apiSurface": "images.edits.v1"
  },
  "usageMetrics": [
    { "metricKey": "input_tokens", "unitCode": "token" },
    { "metricKey": "output_tokens", "unitCode": "token" },
    { "metricKey": "total_tokens", "unitCode": "token" },
    { "metricKey": "input_text_tokens", "unitCode": "token" },
    { "metricKey": "input_image_tokens", "unitCode": "token" }
  ],
  "artifactInputs": [
    {
      "role": "sourceArtifactId",
      "pointer": "/sourceArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    },
    {
      "role": "maskArtifactId",
      "pointer": "/maskArtifactId",
      "required": false,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.provider-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "openai.image.object-remove.v1",
    "releaseDigest": "sha256:155881b780af909f31924457d25c930ee2b8c109bf3ee6f30269d6e993f64d93"
  }
}
