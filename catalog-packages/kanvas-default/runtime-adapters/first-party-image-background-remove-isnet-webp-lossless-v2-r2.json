        "variant": "isnet-general",
        "inputSize": 1024,
        "normalization": "isnet"
      },
      "sharpVersion": "0.35.3",
      "foregroundEncoding": "webp-lossless-effort-3",
      "onnxRuntimeNodeVersion": "1.27.0"
    },
    "const": {
      "model": {
        "family": "isnet",
        "sha256": "cc2c9f5c1751b9737cb81e708ff0c5e9542c2205daed22418a4fd2ab5d4c481a",
        "source": "huggingface.co/imgly/isnet-general-onnx@440dea96dd4a3b06bbbf5abec3e26569dd7ec49f/onnx/model.onnx",
        "license": "MIT",
        "variant": "isnet-general",
