      },
      "sharpVersion": "0.35.3",
      "foregroundEncoding": "webp-lossless-effort-3",
      "onnxRuntimeNodeVersion": "1.27.0"
    }
  },
  "artifactInputs": [
    {
      "role": "sourceArtifactId",
      "pointer": "/sourceArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.worker-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "first-party.image.background-remove.isnet.webp-lossless.v2",
    "releaseDigest": "sha256:08045d33aaee12f0b83cbee7bd2da9d5ccd7bf688a8db6994ae3f23b28d858ae"
  }
}
