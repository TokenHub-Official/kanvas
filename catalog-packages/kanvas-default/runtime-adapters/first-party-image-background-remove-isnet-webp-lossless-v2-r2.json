{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "first-party.image.background-remove.isnet.webp-lossless.v2",
  "revision": 2,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "背景移除 · Worker",
      "en-US": "Background removal · Worker"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将背景移除的公开输入输出转换为Worker运行协议。",
      "en-US": "Adapts the public Background removal contract to the Worker runtime protocol."
    }
  },
  "executionTarget": "worker",
  "sourceKinds": ["model_resource"],
  "supportedModelFormats": ["onnx"],
  "modelResourceInterfaceDigest": "sha256:c3a88630834b92c6b6798e3c0b80f68290e61225f2ba5fafdaac231c83ab839c",
  "invocationInputSchema": {
    "$id": "kanvas.image-background-remove-input.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["sourceArtifactId", "refinement"],
    "properties": {
      "refinement": {
        "enum": ["standard", "fine"],
        "type": "string",
        "x-kanvas-semantic-type": "text.plain"
      },
      "subjectHint": {
        "type": "string",
        "maxLength": 240,
        "minLength": 1,
        "x-kanvas-semantic-type": "text.plain"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.image"
      }
    },
    "additionalProperties": false
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-background-remove-result.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "foregroundArtifactId",
      "maskArtifactId",
      "qualitySignals"
    ],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-background-remove-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "maskArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": {
            "const": "attempt-output-artifact/v1"
          },
          "outputRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.mask"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "foregroundRatio",
          "uncertainEdgeRatio",
          "modelVariant",
          "modelDigest",
          "refinement"
        ],
        "properties": {
          "refinement": {
            "enum": ["standard", "fine"],
            "type": "string"
          },
          "modelDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "modelVariant": {
            "enum": ["u2net", "u2netp", "isnet-general", "isnet-general-fp16"],
            "type": "string"
          },
          "schemaVersion": {
            "const": "kanvas.image-background-remove-quality/v1"
          },
          "foregroundRatio": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          },
          "uncertainEdgeRatio": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      },
      "foregroundArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": {
            "const": "attempt-output-artifact/v1"
          },
          "outputRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.foreground"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
