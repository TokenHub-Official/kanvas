    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.worker-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "first-party.image.light-enhance.deterministic.v1",
    "releaseDigest": "sha256:7138faffa143c1ff78f24a12fadf21c72c7c448c50d1ddd1e13b97501ba36c5f"
  },
  "selectionPolicy": {
