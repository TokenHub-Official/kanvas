{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "first-party.image.background-compose.deterministic.v1",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "背景合成 · Worker",
      "en-US": "Background compose · Worker"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将背景合成的公开输入输出转换为Worker运行协议。",
      "en-US": "Adapts the public Background compose contract to the Worker runtime protocol."
    }
  },
  "executionTarget": "worker",
  "sourceKinds": ["plugin"],
  "supportedModelFormats": [],
  "invocationInputSchema": {
    "$id": "kanvas.image-background-compose-input.v1",
    "type": "object",
    "allOf": [
      {
        "if": {
          "properties": {
            "background": {
              "properties": {
                "kind": {
                  "const": "artifact"
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "background": {
              "required": ["artifactId"]
            }
          }
        }
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["foregroundArtifactId", "background", "canvas", "placement"],
    "properties": {
      "canvas": {
        "type": "object",
        "required": ["width", "height"],
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 8192,
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "maximum": 8192,
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "layout.canvas"
      },
      "placement": {
        "type": "object",
        "required": ["x", "y", "width", "height", "fit"],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "fit": {
            "enum": ["contain", "cover", "stretch"],
            "type": "string"
          },
          "width": {
            "type": "integer",
            "maximum": 8192,
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "maximum": 8192,
            "minimum": 1
          },
          "opacity": {
            "type": "number",
            "default": 1,
            "maximum": 1,
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "layout.placement"
      },
      "background": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "color"],
            "properties": {
              "kind": {
                "const": "color"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{8}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "artifactId", "fit"],
            "properties": {
              "fit": {
                "enum": ["cover", "contain", "stretch"],
                "type": "string"
              },
              "kind": {
                "const": "artifact"
              },
              "artifactId": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              }
            },
            "additionalProperties": false
          }
        ],
        "x-kanvas-semantic-type": "background.source"
      },
      "maskArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.mask"
      },
      "foregroundArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.foreground"
      }
    },
    "additionalProperties": false
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-background-compose-result.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "imageArtifactId",
      "compositionMaskArtifactId",
      "canvas",
      "resolvedPlacement",
      "inputArtifactIds",
      "qualitySignals"
    ],
    "properties": {
      "canvas": {
        "type": "object",
        "required": ["width", "height"],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "layout.canvas"
      },
      "schemaVersion": {
        "const": "kanvas.image-background-compose-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generative",
          "deterministic",
          "alphaComposited",
          "colorSpace"
        ],
        "properties": {
          "colorSpace": {
            "const": "srgb"
          },
          "generative": {
            "const": false
          },
          "deterministic": {
            "const": true
          },
          "schemaVersion": {
            "const": "kanvas.image-background-compose-quality/v1"
          },
          "alphaComposited": {
            "const": true
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      },
      "imageArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": {
            "const": "attempt-output-artifact/v1"
          },
          "outputRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.image"
      },
      "inputArtifactIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "maxItems": 3,
        "minItems": 1,
        "uniqueItems": true,
        "x-kanvas-semantic-type": "artifact.image_list"
      },
      "resolvedPlacement": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "layout.placement"
      },
      "compositionMaskArtifactId": {
        "type": "object",
        "additionalProperties": false,
        "required": ["$kanvas", "outputRole", "outputIndex"],
        "properties": {
          "$kanvas": {
            "const": "attempt-output-artifact/v1"
          },
          "outputRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "x-kanvas-attempt-output-artifact": true,
        "x-kanvas-semantic-type": "artifact.mask"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "default": {
      "operation": "image.background.compose",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 2
    },
    "const": {
      "operation": "image.background.compose",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 2
    }
  },
  "artifactInputs": [
    {
      "role": "foregroundArtifactId",
      "pointer": "/foregroundArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    },
    {
      "role": "maskArtifactId",
      "pointer": "/maskArtifactId",
      "required": false,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.worker-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "first-party.image.background-compose.deterministic.v1",
    "releaseDigest": "sha256:f754e109633d3bdadf7b0c992fb7070879907641b5a8d00c88d134d90af9ef57"
  }
}
