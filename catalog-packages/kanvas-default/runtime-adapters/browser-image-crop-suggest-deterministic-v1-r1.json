{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "browser.image.crop-suggest.deterministic.v1",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "裁剪建议 · 浏览器",
      "en-US": "Crop suggestions · Browser"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将裁剪建议的公开输入输出转换为浏览器运行协议。",
      "en-US": "Adapts the public Crop suggestions contract to the Browser runtime protocol."
    }
  },
  "executionTarget": "browser",
  "sourceKinds": ["plugin"],
  "supportedModelFormats": [],
  "invocationInputSchema": {
    "$id": "kanvas.image-crop-suggest-input.v1",
    "type": "object",
    "$defs": {
      "pixelBounds": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["sourceArtifactId", "aspectRatios"],
    "properties": {
      "aspectRatios": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"
        },
        "maxItems": 8,
        "minItems": 1,
        "uniqueItems": true,
        "x-kanvas-semantic-type": "value.any"
      },
      "subjectBounds": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/pixelBounds"
        },
        "maxItems": 16,
        "x-kanvas-semantic-type": "layout.bounds"
      },
      "safeMarginRatio": {
        "type": "number",
        "default": 0.05,
        "maximum": 0.25,
        "minimum": 0,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.image"
      },
      "maxSuggestionsPerRatio": {
        "type": "integer",
        "default": 1,
        "maximum": 3,
        "minimum": 1,
        "x-kanvas-semantic-type": "number.scalar"
      }
    },
    "additionalProperties": false
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-crop-suggest-result.v1",
    "type": "object",
    "$defs": {
      "pixelBounds": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "normalizedBounds": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          },
          "y": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          },
          "width": {
            "type": "number",
            "maximum": 1,
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "maximum": 1,
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "sourceWidth",
      "sourceHeight",
      "suggestions",
      "qualitySignals"
    ],
    "properties": {
      "sourceWidth": {
        "type": "integer",
        "minimum": 1,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "suggestions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "suggestionId",
            "aspectRatio",
            "rank",
            "bounds",
            "normalizedBounds",
            "subjectRetention",
            "confidence",
            "method"
          ],
          "properties": {
            "rank": {
              "type": "integer",
              "maximum": 3,
              "minimum": 1
            },
            "bounds": {
              "$ref": "#/$defs/pixelBounds"
            },
            "method": {
              "const": "deterministic_saliency_projection"
            },
            "confidence": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            },
            "aspectRatio": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"
            },
            "suggestionId": {
              "type": "string",
              "pattern": "^crop-[1-9][0-9]*$"
            },
            "normalizedBounds": {
              "$ref": "#/$defs/normalizedBounds"
            },
            "subjectRetention": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "maxItems": 24,
        "x-kanvas-semantic-type": "value.any"
      },
      "sourceHeight": {
        "type": "integer",
        "minimum": 1,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "schemaVersion": {
        "const": "kanvas.image-crop-suggest-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generative",
          "sourceModified",
          "saliencyMethod",
          "subjectBoundsProvided"
        ],
        "properties": {
          "generative": {
            "const": false
          },
          "schemaVersion": {
            "const": "kanvas.image-crop-suggest-quality/v1"
          },
          "saliencyMethod": {
            "const": "alpha_luminance_projection"
          },
          "sourceModified": {
            "const": false
          },
          "subjectBoundsProvided": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "default": {
      "operation": "image.crop.suggest",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 0
    },
    "const": {
      "operation": "image.crop.suggest",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 0
    }
  },
  "runtimeProfile": {
    "kind": "browser.image-analysis.v1",
    "version": 1,
    "settings": {
      "backend": "javascript",
      "role": "crop_suggest"
    }
  },
  "artifactInputs": [
    {
      "role": "sourceArtifactId",
      "pointer": "/sourceArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.browser-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "browser.image.crop-suggest.deterministic.v1",
    "releaseDigest": "sha256:3e913e1537d679f0507d3d245e42745af70dc729d73215aa00f2cb5984ff5a37"
  },
  "selectionPolicy": {
    "scope": "capability_private",
    "capabilityKey": "image.crop.suggest"
  }
}
