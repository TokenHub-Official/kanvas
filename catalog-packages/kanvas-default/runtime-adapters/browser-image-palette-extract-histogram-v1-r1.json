{
  "schemaVersion": "kanvas.runtime-adapter-definition/v1",
  "adapterKey": "browser.image.palette-extract.histogram.v1",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "色板提取 · 浏览器",
      "en-US": "Palette extract · Browser"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "将色板提取的公开输入输出转换为浏览器运行协议。",
      "en-US": "Adapts the public Palette extract contract to the Browser runtime protocol."
    }
  },
  "executionTarget": "browser",
  "sourceKinds": ["plugin"],
  "supportedModelFormats": [],
  "invocationInputSchema": {
    "$id": "kanvas.image-palette-extract-input.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["sourceArtifactId"],
    "properties": {
      "colorCount": {
        "type": "integer",
        "default": 6,
        "maximum": 12,
        "minimum": 2,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "sampleSize": {
        "type": "integer",
        "default": 128,
        "maximum": 512,
        "minimum": 32,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "alphaThreshold": {
        "type": "integer",
        "default": 16,
        "maximum": 255,
        "minimum": 0,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "x-kanvas-semantic-type": "artifact.image"
      }
    },
    "additionalProperties": false
  },
  "invocationOutputSchema": {
    "$id": "kanvas.image-palette-extract-result.v1",
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
      "schemaVersion",
      "sourceWidth",
      "sourceHeight",
      "colorSpace",
      "colors",
      "transparentRatio",
      "qualitySignals"
    ],
    "properties": {
      "colors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "rank",
            "hex",
            "red",
            "green",
            "blue",
            "proportion",
            "luminance",
            "role"
          ],
          "properties": {
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "red": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "blue": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "rank": {
              "type": "integer",
              "maximum": 12,
              "minimum": 1
            },
            "role": {
              "enum": ["dominant", "accent", "neutral"],
              "type": "string"
            },
            "green": {
              "type": "integer",
              "maximum": 255,
              "minimum": 0
            },
            "luminance": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            },
            "proportion": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "maxItems": 12,
        "minItems": 1,
        "x-kanvas-semantic-type": "value.any"
      },
      "colorSpace": {
        "const": "srgb",
        "x-kanvas-semantic-type": "value.any"
      },
      "sourceWidth": {
        "type": "integer",
        "minimum": 1,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "sourceHeight": {
        "type": "integer",
        "minimum": 1,
        "x-kanvas-semantic-type": "number.scalar"
      },
      "schemaVersion": {
        "const": "kanvas.image-palette-extract-result/v1",
        "x-kanvas-semantic-type": "value.any"
      },
      "qualitySignals": {
        "type": "object",
        "required": [
          "schemaVersion",
          "generative",
          "sourceModified",
          "deterministic",
          "quantizationBits",
          "sampledPixelCount"
        ],
        "properties": {
          "generative": {
            "const": false
          },
          "deterministic": {
            "const": true
          },
          "schemaVersion": {
            "const": "kanvas.image-palette-extract-quality/v1"
          },
          "sourceModified": {
            "const": false
          },
          "quantizationBits": {
            "const": 5
          },
          "sampledPixelCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "x-kanvas-semantic-type": "quality.signals"
      },
      "transparentRatio": {
        "type": "number",
        "maximum": 1,
        "minimum": 0,
        "x-kanvas-semantic-type": "number.scalar"
      }
    },
    "additionalProperties": false
  },
  "configurationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "default": {
      "operation": "image.palette.extract",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 0
    },
    "const": {
      "operation": "image.palette.extract",
      "colorSpace": "srgb",
      "generative": false,
      "providerCost": false,
      "externalEgress": false,
      "algorithmVersion": "batch-c-deterministic-rgba-v1",
      "maximumSourcePixels": 32000000,
      "outputArtifactCount": 0
    }
  },
  "runtimeProfile": {
    "kind": "browser.image-analysis.v1",
    "version": 1,
    "settings": {
      "backend": "javascript",
      "role": "palette_extract"
    }
  },
  "artifactInputs": [
    {
      "role": "sourceArtifactId",
      "pointer": "/sourceArtifactId",
      "required": true,
      "mediaTypes": ["image/png", "image/jpeg", "image/webp"]
    }
  ],
  "executable": {
    "kind": "built_in",
    "packageKey": "kanvas.browser-image-runtime",
    "packageVersion": "1.0.0",
    "entrypoint": "browser.image.palette-extract.histogram.v1",
    "releaseDigest": "sha256:6dfd29075c38a2e57de02e13b94114e799610d590d870ae300a62c0f158a1e15"
  },
  "selectionPolicy": {
    "scope": "capability_private",
    "capabilityKey": "image.palette.extract"
  }
}
