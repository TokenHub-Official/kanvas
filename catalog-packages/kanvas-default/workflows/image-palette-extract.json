    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "在浏览器本地确定性提取主色、比例与色彩角色。",
      "en-US": "Extract dominant colors, ratios, and color roles locally in the browser."
    }
  },
  "category": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "图片分析",
      "en-US": "Image analysis"
    }
