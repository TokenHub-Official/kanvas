  "topology": {
    "schemaVersion": 1,
    "key": "image_palette_extract",
    "entryNodeKey": "extract",
    "limits": {
      "maxNodeRuns": 1,
      "timeoutMs": 120000
    },
    "nodes": [
      {
        "key": "extract",
        "kind": "invoke",
        "capability": {
