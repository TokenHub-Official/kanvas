            "source": "node_output",
            "nodeKey": "extract",
            "scope": "root",
            "pointer": "/colors"
          }
        }
      },
      "transparentRatio": {
        "required": true,
        "value": {
          "$value": {
            "source": "node_output",
            "nodeKey": "extract",
            "scope": "root",
            "pointer": "/transparentRatio"
          }
        }
