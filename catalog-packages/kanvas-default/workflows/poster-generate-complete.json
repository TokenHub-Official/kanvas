{
  "schemaVersion": "kanvas.workflow-catalog-asset/v1",
  "workflowKey": "poster_generate_complete",
  "revision": 1,
  "displayName": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "完整海报生成",
      "en-US": "Complete poster generation"
    }
  },
  "description": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "可选参考图；有参考图时进入图片编辑，没有参考图时直接生成，最终返回统一结果图。",
      "en-US": "Choose image generation or image editing based on an optional reference image, then return one normalized result."
    }
  },
  "category": {
    "defaultLocale": "zh-CN",
    "values": {
      "zh-CN": "海报制作",
      "en-US": "Poster creation"
    }
  },
  "topology": {
    "schemaVersion": 1,
    "key": "poster_generate_complete",
    "entryNodeKey": "has_reference",
    "limits": {
      "maxNodeRuns": 3,
      "timeoutMs": 600000
    },
    "nodes": [
      {
        "key": "has_reference",
        "kind": "switch",
        "value": {
          "$value": {
            "source": "workflow_input",
            "pointer": "/referenceArtifactId"
          }
        },
        "cases": [
          {
            "when": {
              "operator": "exists"
            },
            "next": ["edit_from_reference"]
          }
        ],
        "defaultNext": ["generate_without_reference"]
      },
      {
        "key": "generate_without_reference",
        "kind": "invoke",
        "capability": {
          "contractId": "image.generate",
          "revision": 1,
          "canonicalDigest": "sha256:60d1cc4a6436d3a4b1297d571b46e43a51d07c6ffb4f2487bd307679c7260377"
        },
        "input": {
          "prompt": {
            "$string": [
              "生成一张完整商业海报，构图清晰并保留合理文字空间。用户额外需求：",
              {
                "$value": {
                  "source": "workflow_input",
                  "pointer": "/requirements"
                }
              }
            ]
          }
        },
        "next": []
      },
      {
        "key": "edit_from_reference",
        "kind": "invoke",
        "capability": {
          "contractId": "image.edit",
          "revision": 1,
          "canonicalDigest": "sha256:d20582a665923b4a0f8fa4b5ed133a1ee35bce10e5a2aa4160eef8b50c1a31f1"
        },
        "input": {
          "sourceArtifactId": {
            "$value": {
              "source": "workflow_input",
              "pointer": "/referenceArtifactId"
            }
          },
          "prompt": {
            "$string": [
              "基于参考图片生成一张完整商业海报，保留主体特征并优化构图。用户额外需求：",
              {
                "$value": {
                  "source": "workflow_input",
                  "pointer": "/requirements"
                }
              }
            ]
          }
        },
        "next": []
      }
    ],
    "outputs": {
      "schemaVersion": {
        "required": true,
        "value": "kanvas.poster-generate-complete-result/v1"
      },
      "resultImageArtifactId": {
        "required": true,
        "value": {
          "$coalesce": [
            {
              "$value": {
                "source": "node_output",
                "nodeKey": "generate_without_reference",
                "scope": "root",
                "pointer": "/imageArtifactId"
              }
            },
            {
              "$value": {
                "source": "node_output",
                "nodeKey": "edit_from_reference",
                "scope": "root",
                "pointer": "/imageArtifactId"
              }
            }
          ]
        }
      }
    }
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.poster-generate-complete-input.v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["requirements"],
    "properties": {
      "requirements": {
        "title": "额外需求",
        "description": "描述海报主题、风格、配色、文字空间与其他制作要求。",
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "referenceArtifactId": {
        "title": "参考图片（可选）",
        "description": "提供参考图时走图片编辑流程；暂时只支持一张参考图。",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.poster-generate-complete-result.v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "resultImageArtifactId"],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.poster-generate-complete-result/v1"
      },
      "resultImageArtifactId": {
        "title": "结果图",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    }
  },
  "requiredCapabilities": [
    {
      "key": "image.generate",
      "revision": 1,
      "canonicalDigest": "sha256:60d1cc4a6436d3a4b1297d571b46e43a51d07c6ffb4f2487bd307679c7260377"
    },
    {
      "key": "image.edit",
      "revision": 1,
      "canonicalDigest": "sha256:d20582a665923b4a0f8fa4b5ed133a1ee35bce10e5a2aa4160eef8b50c1a31f1"
    }
  ],
  "canonicalDigest": "sha256:4e410bd7c70c29d9a5fa7cbdaac9f0655355d9fa625e697f8ad8a494934a7986"
}
