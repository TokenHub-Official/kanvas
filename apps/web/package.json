    "lint": "eslint src vite.config.ts",
    "prepare:browser-runtime": "node scripts/prepare-browser-runtime-assets.mjs && node scripts/prepare-fluent-emoji-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
