# Server-only local configuration. Shared database and storage values live in
# the repository-root .env.local.

# All HTTP values have local defaults and may stay commented.
# KANVAS_HTTP_HOST=0.0.0.0
# KANVAS_HTTP_PORT=3000
# KANVAS_HTTP_TRUSTED_PROXY_HOPS=0
# KANVAS_HTTP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# KANVAS_CANCEL_GRACE_MS=30000

# Authentication secret is the only required Server-local value.
KANVAS_AUTH_SECRET=replace-with-at-least-32-random-characters
# KANVAS_AUTH_BASE_URL=http://127.0.0.1:3000
# KANVAS_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173
# KANVAS_AUTH_EMAIL_PASSWORD_ENABLED=true
# KANVAS_AUTH_SESSION_EXPIRES_IN_SECONDS=604800
# KANVAS_AUTH_SESSION_UPDATE_AGE_SECONDS=86400

# Demo mode defaults to enabled outside production.
# KANVAS_DEMO_MODE=true
# KANVAS_DEMO_WORKSPACE_ID=01K00000000000000000000000
# KANVAS_DEMO_ACTOR_ID=01K00000000000000000000001

# Development bootstrap identity used by `pnpm setup:dev`.
KANVAS_DEV_ADMIN_EMAIL=admin@kanvas.local
KANVAS_DEV_ADMIN_PASSWORD=replace-with-at-least-12-local-only-characters
# KANVAS_DEV_ADMIN_NAME=Kanvas Admin
# KANVAS_DEV_ORGANIZATION_SLUG=kanvas-local
# KANVAS_DEV_ORGANIZATION_NAME=Kanvas Local
# KANVAS_DEV_WORKSPACE_SLUG=studio
# KANVAS_DEV_WORKSPACE_NAME=Kanvas Studio

# Required only when the shared execution targets include browser.
# KANVAS_BROWSER_RUNTIME_RELEASE_ID=01K00000000000000000000010
# KANVAS_BROWSER_RUNTIME_RELEASE_DIGEST=sha256:replace-with-64-lowercase-hex-characters
# KANVAS_BROWSER_SESSION_TTL_SECONDS=3600
# KANVAS_BROWSER_ATTEMPT_LEASE_MS=30000
# KANVAS_BROWSER_CANDIDATE_LIMIT=20
