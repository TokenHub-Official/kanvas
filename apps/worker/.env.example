# Worker-only local configuration. Shared database, storage and deployment
# policy values live in the repository-root .env.local.

KANVAS_REDIS_HOST=127.0.0.1
KANVAS_REDIS_PORT=6379
KANVAS_REDIS_DB=0
# KANVAS_REDIS_PASSWORD=replace-for-local-development

# Defaults cover the local orchestration Worker.
# KANVAS_WORKER_HEALTH_HOST=127.0.0.1
# KANVAS_WORKER_HEALTH_PORT=3001
# KANVAS_WORKER_ROLES=orchestration,execution,outbox-relay,scheduler,reconciler,maintenance
# KANVAS_ATTEMPT_LEASE_DURATION_MS=30000
# KANVAS_ATTEMPT_HEARTBEAT_INTERVAL_MS=10000
# KANVAS_ATTEMPT_TIMEOUT_MS=300000
# KANVAS_AGENT_RUN_CONCURRENCY=4 # max min(32, max(1, database connection limit - 2))
# KANVAS_RECONCILER_POLL_INTERVAL_MS=1000
# KANVAS_RECONCILER_STALE_AFTER_MS=15000
# KANVAS_RECONCILER_BATCH_SIZE=20

# Provider execution is opt-in. Adapter keys and origins are lists; deployment
# secret and hard-bound maps stay structured in the shared environment file.
# Optional restriction; omitted uses installed adapters when Provider execution is enabled.
# KANVAS_PROVIDER_ADAPTER_KEYS=openai.responses.v1
# Optional additional restriction on validated Provider API endpoints.
# KANVAS_PROVIDER_ALLOWED_ORIGINS=https://api.openai.com
# KANVAS_PROVIDER_PROXY_URL=http://127.0.0.1:7890
# Public HTTPS results download by default; use false only to intentionally disable them.
# KANVAS_PROVIDER_RESULT_DOWNLOADS_ENABLED=false
# KANVAS_PROVIDER_RESULT_ALLOWED_ORIGINS=https://example-cdn.invalid
# KANVAS_PROVIDER_ALLOW_HTTP=false
# KANVAS_PROVIDER_ALLOW_PRIVATE_NETWORKS=false
# KANVAS_PROVIDER_MAX_REQUEST_BYTES=16777216
# KANVAS_PROVIDER_MAX_RESPONSE_BYTES=33554432
# KANVAS_PROVIDER_FAKE_ADAPTER_ENABLED=false

# Optional development-only image adapter.
# KANVAS_WORKER_DETERMINISTIC_IMAGE_ADAPTER_ENABLED=false

# Storage maintenance values are Worker-owned and only apply when Storage is set.
# KANVAS_STORAGE_GC_POLL_INTERVAL_MS=5000
# KANVAS_STORAGE_GC_CLAIM_LEASE_MS=30000
# KANVAS_STORAGE_GC_BASE_RETRY_MS=5000
# KANVAS_STORAGE_GC_MAX_RETRY_MS=300000
# KANVAS_MODEL_IMPORT_PROXY_URL=http://127.0.0.1:7890
