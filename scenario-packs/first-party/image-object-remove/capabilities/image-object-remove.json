{
  "schemaVersion": 1,
  "contractKey": "image.object.remove",
  "revision": 1,
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-object-remove-input.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId"
    ],
    "oneOf": [
      {
        "required": [
          "maskArtifactId"
        ]
      },
      {
        "required": [
          "regions"
        ]
      }
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "maskArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "regions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 16384
                  }
                }
              }
            }
          }
        }
      },
      "guidance": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-object-remove-result.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "repairedArtifactId",
      "removedRegionMaskArtifactId",
      "qualitySignals"
    ],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-object-remove-result/v1"
      },
      "repairedArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "removedRegionMaskArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "qualitySignals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "method",
          "generative",
          "outsideMaskPixelsPreserved",
          "removedPixelRatio"
        ],
        "properties": {
          "schemaVersion": {
            "const": "kanvas.image-object-remove-quality/v1"
          },
          "method": {
            "const": "generative_inpaint"
          },
          "generative": {
            "const": true
          },
          "outsideMaskPixelsPreserved": {
            "const": true
          },
          "removedPixelRatio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    }
  },
  "idempotencyMode": "keyed",
  "supportedInvokers": [
    "workflow"
  ]
}
