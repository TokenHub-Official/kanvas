{
  "schemaVersion": 1,
  "contractKey": "image.palette.extract",
  "revision": 1,
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-palette-extract-input.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId"
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "colorCount": {
        "type": "integer",
        "minimum": 2,
        "maximum": 12,
        "default": 6
      },
      "alphaThreshold": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "default": 16
      },
      "sampleSize": {
        "type": "integer",
        "minimum": 32,
        "maximum": 512,
        "default": 128
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-palette-extract-result.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "sourceWidth",
      "sourceHeight",
      "colorSpace",
      "colors",
      "transparentRatio",
      "qualitySignals"
    ],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-palette-extract-result/v1"
      },
      "sourceWidth": {
        "type": "integer",
        "minimum": 1
      },
      "sourceHeight": {
        "type": "integer",
        "minimum": 1
      },
      "colorSpace": {
        "const": "srgb"
      },
      "colors": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank",
            "hex",
            "red",
            "green",
            "blue",
            "proportion",
            "luminance",
            "role"
          ],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "red": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "green": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "blue": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "proportion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "luminance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "dominant",
                "accent",
                "neutral"
              ]
            }
          }
        }
      },
      "transparentRatio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "qualitySignals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "generative",
          "sourceModified",
          "deterministic",
          "quantizationBits",
          "sampledPixelCount"
        ],
        "properties": {
          "schemaVersion": {
            "const": "kanvas.image-palette-extract-quality/v1"
          },
          "generative": {
            "const": false
          },
          "sourceModified": {
            "const": false
          },
          "deterministic": {
            "const": true
          },
          "quantizationBits": {
            "const": 5
          },
          "sampledPixelCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "idempotencyMode": "keyed",
  "supportedInvokers": [
    "workflow"
  ]
}
