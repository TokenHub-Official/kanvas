{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kanvas.brand-social-starter-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultImageArtifactId", "canvas"],
  "properties": {
    "schemaVersion": {
      "const": "kanvas.brand-social-starter-result/v1"
    },
    "resultImageArtifactId": {
      "title": "品牌底图",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      },
      "additionalProperties": false
    }
  }
}
