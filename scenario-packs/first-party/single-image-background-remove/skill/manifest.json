{
  "schemaVersion": 1,
  "skillKey": "first-party.single-image-background-remove",
  "displayName": "单图去背景",
  "nonProduction": false,
  "entrypoints": [
    {
      "entrypointKey": "remove-background",
      "displayName": "去背景",
