{
  "schemaVersion": 1,
  "contractKey": "image.generate",
  "revision": 2,
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-generate-input.v1",
    "type": "object",
    "additionalProperties": false,
    "x-kanvas-provider-model-operation": "image.generate",
    "x-kanvas-provider-parameter-keys": [
      "aspectRatio",
      "resolution",
      "size",
      "quality",
      "outputFormat",
      "background",
      "outputCompression",
      "numberOfImages",
      "seed"
    ],
    "required": ["prompt"],
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "referenceArtifactIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 14,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "aspectRatio": {
        "type": "string",
        "enum": ["auto", "1:1", "3:2", "2:3", "4:3", "3:4", "4:5", "5:4", "16:9", "9:16", "21:9"]
      },
      "resolution": {
        "type": "string",
        "enum": ["auto", "512", "1k", "2k", "4k"]
      },
      "size": {
        "type": "string",
        "enum": ["auto", "1024x1024", "1536x1024", "1024x1536"]
      },
      "quality": {
        "type": "string",
        "enum": ["auto", "low", "medium", "high"]
      },
      "outputFormat": {
        "type": "string",
        "enum": ["png", "jpeg", "webp"]
      },
      "background": {
        "type": "string",
        "enum": ["auto", "opaque", "transparent"]
      },
      "outputCompression": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "numberOfImages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-generate-result.v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "imageArtifactId"],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-generate-result/v1"
      },
      "imageArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    }
  },
  "idempotencyMode": "keyed",
  "supportedInvokers": ["workflow"]
}
