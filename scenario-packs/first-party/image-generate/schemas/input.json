{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kanvas.image-generate-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "prompt": {
      "title": "画面要求",
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "referenceArtifactIds": {
      "title": "参考图片",
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    },
    "aspectRatio": {
      "title": "画面比例",
      "type": "string",
      "enum": ["auto", "1:1", "3:2", "2:3", "4:3", "3:4", "4:5", "5:4", "16:9", "9:16", "21:9"]
    },
    "resolution": {
      "title": "分辨率",
      "type": "string",
      "enum": ["auto", "512", "1k", "2k", "4k"]
    },
    "size": {
      "title": "尺寸",
      "type": "string",
      "enum": ["auto", "1024x1024", "1536x1024", "1024x1536"]
    },
    "quality": {
      "title": "质量",
      "type": "string",
      "enum": ["auto", "low", "medium", "high"]
    },
    "outputFormat": {
      "title": "格式",
      "type": "string",
      "enum": ["png", "jpeg", "webp"]
    },
    "background": {
      "title": "背景",
      "type": "string",
      "enum": ["auto", "opaque", "transparent"]
    },
    "outputCompression": {
      "title": "压缩质量",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "numberOfImages": {
      "title": "图片数量",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "seed": {
      "title": "随机种子",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
