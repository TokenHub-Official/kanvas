      },
      "next": [
        "extract_text"
      ]
    },
    {
      "key": "extract_text",
      "kind": "invoke",
      "capability": {
        "contractId": "image.text.extract",
        "revision": 1,
        "canonicalDigest": "sha256:5b4077c57b11c288d5324c5148f48a3c6c420b835b4ca0829fb6fe3edc171b72"
