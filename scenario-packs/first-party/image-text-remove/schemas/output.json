{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kanvas.image-text-remove-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repairedArtifactId",
    "removedRegionMaskArtifactId",
    "qualitySignals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "kanvas.image-object-remove-result/v1"
    },
    "repairedArtifactId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "removedRegionMaskArtifactId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "qualitySignals": {
      "type": "object"
    }
  }
}
