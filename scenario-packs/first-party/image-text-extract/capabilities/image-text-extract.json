{
  "schemaVersion": 1,
  "contractKey": "image.text.extract",
  "revision": 1,
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-text-extract-input.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceArtifactId"
    ],
    "properties": {
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "languages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        }
      },
      "granularity": {
        "type": "string",
        "enum": [
          "line",
          "word"
        ],
        "default": "line"
      },
      "minimumConfidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "kanvas.image-text-extract-result.v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "sourceArtifactId",
      "sourceWidth",
      "sourceHeight",
      "text",
      "language",
      "direction",
      "confidence",
      "blocks",
      "regions",
      "qualitySignals"
    ],
    "properties": {
      "schemaVersion": {
        "const": "kanvas.image-text-extract-result/v1"
      },
      "sourceArtifactId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "sourceWidth": {
        "type": "integer",
        "minimum": 1
      },
      "sourceHeight": {
        "type": "integer",
        "minimum": 1
      },
      "text": {
        "type": "string"
      },
      "language": {
        "type": [
          "string",
          "null"
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "ltr",
          "rtl",
          "ttb",
          "unknown"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "blocks": {
        "type": "array",
        "maxItems": 10000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "text",
            "confidence",
            "polygon"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "line",
                "word"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "polygon": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "regions": {
        "type": "array",
        "maxItems": 10000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "qualitySignals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "method",
          "generative",
          "lowConfidence"
        ],
        "properties": {
          "schemaVersion": {
            "const": "kanvas.image-text-extract-quality/v1"
          },
          "method": {
            "type": "string"
          },
          "generative": {
            "const": false
          },
          "lowConfidence": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "idempotencyMode": "keyed",
  "supportedInvokers": [
    "workflow"
  ]
}
