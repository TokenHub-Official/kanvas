# Shared local configuration loaded by Server and Worker.
KANVAS_ENVIRONMENT=development
KANVAS_INSTANCE_ID=kanvas-local

# Optional instance-wide OAuth sign-in. Restart Server after changing this file.
# KANVAS_AUTH_OAUTH_CONFIG_FILE=/absolute/path/to/oauth.json

# Optional verified-email registration delivery. Configuring this only exposes
# the method to the Instance Administrator; registration remains closed until
# the account_only policy enables it.
# KANVAS_AUTH_EMAIL_SMTP_HOST=smtp.example.com
# KANVAS_AUTH_EMAIL_SMTP_PORT=587
# KANVAS_AUTH_EMAIL_SMTP_SECURE=false
# KANVAS_AUTH_EMAIL_SMTP_REQUIRE_TLS=true
# KANVAS_AUTH_EMAIL_SMTP_USER=kanvas
# KANVAS_AUTH_EMAIL_SMTP_PASSWORD=replace-for-local-development
# KANVAS_AUTH_EMAIL_FROM_ADDRESS=kanvas@example.com
# KANVAS_AUTH_EMAIL_FROM_NAME=Kanvas
# Local browser-flow alternative; never use in production.
# KANVAS_AUTH_EMAIL_DEVELOPMENT_OUTBOX_FILE=/absolute/path/.tmp/email-verification.jsonl

# MySQL is required. Use direct passwords only for local development.
KANVAS_DATABASE_HOST=127.0.0.1
KANVAS_DATABASE_PORT=3306
KANVAS_DATABASE_NAME=kanvas
KANVAS_DATABASE_USER=kanvas
KANVAS_DATABASE_PASSWORD=replace-for-local-development
# KANVAS_DATABASE_CONNECTION_LIMIT=10
# Container startup: auto initializes/upgrades; check requires a release job first.
# KANVAS_DB_MIGRATION_MODE=auto
# Alternative to split MySQL fields (do not combine):
# KANVAS_DATABASE_URL=mysql://user:password@db.example:3306/kanvas?ssl=true
# Optional private CA certificate, mounted into the container; verifies TLS.
# KANVAS_DATABASE_SSL_CA_FILE=/run/certs/mysql-ca.pem
# Redis TLS and named ACL users use the connection URL:
# KANVAS_REDIS_URL=rediss://kanvas:password@redis.example:6379/0
# KANVAS_REDIS_TLS_CA_FILE=/run/certs/redis-ca.pem

# Both services must agree on the enabled execution targets.
KANVAS_ENABLED_EXECUTION_TARGETS=worker

# Optional shared release and observability metadata.
# KANVAS_RELEASE_VERSION=0.0.0-development
# KANVAS_LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional development-only Skill source overrides. This is intentionally a
# structured map because every key is a stable package identity.
# KANVAS_AGENT_DEVELOPMENT_SKILL_FILES_JSON={"first-party.brand-social-starter":"/absolute/path/to/SKILL.md"}

# Optional Provider operator restrictions shared by Server and Worker.
# Omit to use persisted instance, Workspace and route policies without an extra overlay.
# KANVAS_PROVIDER_PROXY_URL=http://127.0.0.1:7890
# KANVAS_PROVIDER_DEPLOYMENT_SECRET_MAP_FILE=/absolute/path/provider-secret-map.json
# KANVAS_PROVIDER_KEK_MAP_FILE=/absolute/path/provider-kek-map.json
# KANVAS_PROVIDER_ACTIVE_KEK_VERSION=provider-kek-v1
# KANVAS_PROVIDER_DEPLOYMENT_HARD_BOUNDS_JSON={"allowedAdapterKinds":["openai_native"],"allowedPresetKinds":["openai"],"allowedRegionCodes":["global"],"allowedRoutingModes":["kanvas_fixed"],"allowedExecutionTransparencies":["full"],"maximumCharge":{"currencyCode":"USD","amount":"2"},"maxProviderRequestSeconds":300}

# Optional Storage profile shared by Server and Worker. With no Storage values,
# content transfer endpoints stay disabled.
# KANVAS_STORAGE_KIND=local
# KANVAS_LOCAL_STORAGE_ROOT=/absolute/path/to/kanvas-objects
# KANVAS_LOCAL_STORAGE_PROFILE_ID=01K00000000000000000000020
# KANVAS_LOCAL_STORAGE_TRUSTED_ROOT_ACK=I_ACKNOWLEDGE_SINGLE_NODE_TRUSTED_STORAGE_ROOT
# KANVAS_STORAGE_USER_IMPORT_TTL_MS=3600000
# KANVAS_STORAGE_VERIFICATION_LEASE_MS=120000
# KANVAS_STORAGE_CLEANUP_GRACE_MS=3600000
# KANVAS_STORAGE_MAX_INPUT_BYTES=134217728
# KANVAS_STORAGE_MAX_IMAGE_WIDTH=32768
# KANVAS_STORAGE_MAX_IMAGE_HEIGHT=32768
# KANVAS_STORAGE_MAX_IMAGE_PIXELS=134217728
# KANVAS_STORAGE_MAX_DECODED_BYTES=536870912
# KANVAS_STORAGE_MAX_EXPANSION_RATIO=2048

# S3-compatible alternative to Local Storage. Static credentials are optional;
# the AWS workload/default credential chain is used when they are absent.
# KANVAS_STORAGE_KIND=s3
# KANVAS_S3_STORAGE_PROFILE_ID=01K00000000000000000000021
# KANVAS_S3_ENDPOINT=https://objects.example.com
# KANVAS_S3_REGION=us-east-1
# KANVAS_S3_BUCKET=kanvas-objects
# KANVAS_S3_FORCE_PATH_STYLE=true
# KANVAS_S3_SERVER_SIDE_ENCRYPTION=none
# KANVAS_S3_KMS_KEY_ID=alias/kanvas-storage
# KANVAS_S3_STAGING_DIRECTORY=/absolute/bounded/staging-directory
# KANVAS_S3_ACCESS_KEY_ID=replace-for-local-development
# KANVAS_S3_SECRET_ACCESS_KEY=replace-for-local-development
# KANVAS_S3_SESSION_TOKEN=replace-for-local-development

# Preview defaults are already safe; set only to change the strategy.
# KANVAS_ARTIFACT_PREVIEW_MODE=on_demand
# KANVAS_ARTIFACT_PREVIEW_FALLBACK_ON_MISS=true
# KANVAS_ARTIFACT_PREVIEW_WIDTH=640
# KANVAS_ARTIFACT_PREVIEW_HEIGHT=640
# KANVAS_ARTIFACT_PREVIEW_QUALITY=80
# KANVAS_ARTIFACT_PREVIEW_EFFORT=4
# KANVAS_ARTIFACT_PREVIEW_MAX_SOURCE_BYTES=41943040
# KANVAS_ARTIFACT_PREVIEW_WORKER_CONCURRENCY=2
# KANVAS_ARTIFACT_PREVIEW_GENERATION_ATTEMPTS=3
# KANVAS_ARTIFACT_PREVIEW_GENERATION_RETRY_MS=5000
# KANVAS_ARTIFACT_PREVIEW_CLEANUP_POLL_INTERVAL_MS=30000
# KANVAS_ARTIFACT_PREVIEW_CLEANUP_RETRY_MS=30000
