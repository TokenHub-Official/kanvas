{
  "$comment": "Generated by Kanvas. Do not edit directly. Run pnpm generate:contracts.",
  "additionalProperties": false,
  "$id": "kanvas.workspace-font-catalog.v1",
  "type": "object",
  "required": [
    "fonts"
  ],
  "properties": {
    "fonts": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "$id": "kanvas.workspace-font-revision.v1",
        "type": "object",
        "required": [
          "id",
          "family",
          "category",
          "scripts",
          "languages",
          "license",
          "files",
          "createdAt"
        ],
        "properties": {
          "id": {
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "family": {
            "minLength": 1,
            "maxLength": 240,
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "const": "sans",
                "type": "string"
              },
              {
                "const": "serif",
                "type": "string"
              },
              {
                "const": "display",
                "type": "string"
              },
              {
                "const": "handwriting",
                "type": "string"
              },
              {
                "const": "monospace",
                "type": "string"
              },
              {
                "const": "other",
                "type": "string"
              }
            ]
          },
          "scripts": {
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 80,
              "type": "string"
            }
          },
          "languages": {
            "maxItems": 128,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 80,
              "type": "string"
            }
          },
          "license": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "licenseId",
              "licenseUrl",
              "commercialUseAllowed",
              "modificationAllowed",
              "attributionRequired",
              "shareAlikeRequired",
              "standaloneRedistributionAllowed",
              "modelReleaseStatus",
              "propertyReleaseStatus",
              "trademarkRisk",
              "capturedAt",
              "termsDigest"
            ],
            "properties": {
              "licenseId": {
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              },
              "licenseUrl": {
                "minLength": 9,
                "maxLength": 2048,
                "pattern": "^https://[^\\s]+$",
                "type": "string"
              },
              "commercialUseAllowed": {
                "type": "boolean"
              },
              "modificationAllowed": {
                "type": "boolean"
              },
              "attributionRequired": {
                "type": "boolean"
              },
              "shareAlikeRequired": {
                "type": "boolean"
              },
              "standaloneRedistributionAllowed": {
                "type": "boolean"
              },
              "embeddingAllowed": {
                "type": "boolean"
              },
              "creatorCredit": {
                "maxLength": 500,
                "type": "string"
              },
              "sourceCredit": {
                "maxLength": 500,
                "type": "string"
              },
              "modelReleaseStatus": {
                "anyOf": [
                  {
                    "const": "not_applicable",
                    "type": "string"
                  },
                  {
                    "const": "confirmed",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "propertyReleaseStatus": {
                "anyOf": [
                  {
                    "const": "not_applicable",
                    "type": "string"
                  },
                  {
                    "const": "confirmed",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "trademarkRisk": {
                "anyOf": [
                  {
                    "const": "none_declared",
                    "type": "string"
                  },
                  {
                    "const": "present",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "capturedAt": {
                "format": "date-time",
                "type": "string"
              },
              "termsDigest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            }
          },
          "files": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "artifactId",
                "format",
                "weight",
                "style",
                "subset"
              ],
              "properties": {
                "artifactId": {
                  "minLength": 26,
                  "maxLength": 26,
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "type": "string"
                },
                "format": {
                  "anyOf": [
                    {
                      "const": "ttf",
                      "type": "string"
                    },
                    {
                      "const": "otf",
                      "type": "string"
                    }
                  ]
                },
                "weight": {
                  "minimum": 1,
                  "maximum": 1000,
                  "type": "integer"
                },
                "style": {
                  "anyOf": [
                    {
                      "const": "normal",
                      "type": "string"
                    },
                    {
                      "const": "italic",
                      "type": "string"
                    }
                  ]
                },
                "subset": {
                  "minLength": 1,
                  "maxLength": 80,
                  "type": "string"
                }
              }
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    }
  }
}
