                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 80,
                    "type": "string"
                  }
                },
                "cover": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "artifactId",
                    "alt"
                  ],
                  "properties": {
                    "artifactId": {
                      "minLength": 26,
                      "maxLength": 26,
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "type": "string"
                    },
                    "alt": {
                      "minLength": 1,
                      "maxLength": 500,
                      "type": "string"
                    }
                  }
                },
                "availability": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "standalone",
                    "canvas",
                    "directLink"
                  ],
                  "properties": {
                    "standalone": {
                      "type": "boolean"
                    },
                    "canvas": {
                      "type": "boolean"
                    },
                    "directLink": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "canonicalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "parserProfileVersion": {
          "minLength": 1,
          "maxLength": 80,
          "type": "string"
        },
        "createdByPrincipalId": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        }
      }
    },
    "latestTestRunId": {
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "activeTestRunIds": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 26,
        "maxLength": 26,
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      }
    },
    "checks": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "checkKind",
          "checkProfileVersion",
          "outcome",
          "evidenceSummary",
          "evidenceDigest",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "checkKind": {
            "anyOf": [
              {
                "const": "schema",
                "type": "string"
              },
              {
                "const": "resources",
                "type": "string"
              },
              {
                "const": "security",
                "type": "string"
              },
              {
                "const": "compatibility",
                "type": "string"
              },
              {
                "const": "eval",
                "type": "string"
              }
            ]
          },
          "checkProfileVersion": {
            "minLength": 1,
            "maxLength": 80,
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              }
            ]
          },
          "evidenceSummary": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          },
          "evidenceDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "checkedAt": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    },
    "review": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "decision",
        "reviewerPrincipalId",
        "decidedAt"
      ],
      "properties": {
        "id": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "const": "approved",
              "type": "string"
            },
            {
              "const": "rejected",
              "type": "string"
            }
          ]
        },
        "commentSummary": {
          "minLength": 1,
          "maxLength": 1000,
          "type": "string"
        },
        "reviewerPrincipalId": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "decidedAt": {
          "format": "date-time",
          "type": "string"
        }
      }
    },
    "publishedRevision": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "workspaceId",
        "subjectKind",
        "subjectKey",
        "revision",
        "canonicalDigest",
        "runtimeStatus",
        "publishedAt"
      ],
      "properties": {
        "id": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "workspaceId": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "subjectKind": {
          "const": "workflow",
          "type": "string"
        },
        "subjectKey": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "canonicalDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "runtimeStatus": {
          "const": "enabled",
          "type": "string"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        }
      }
    }
  }
}
