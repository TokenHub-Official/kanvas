{
  "$comment": "Generated by Kanvas. Do not edit directly. Run pnpm generate:contracts.",
  "additionalProperties": false,
  "$id": "kanvas.invitation-summary.v1",
  "type": "object",
  "required": [
    "invitationId",
    "state",
    "organization",
    "workspace",
    "workspaceRole",
    "targetEmailMasked",
    "identityStatus",
    "expiresAt"
  ],
  "properties": {
    "invitationId": {
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        }
      ]
    },
    "organization": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        }
      }
    },
    "workspace": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        }
      }
    },
    "workspaceRole": {
      "anyOf": [
        {
          "const": "owner",
          "type": "string"
        },
        {
          "const": "admin",
          "type": "string"
        },
        {
          "const": "editor",
          "type": "string"
        },
        {
          "const": "operator",
          "type": "string"
        },
        {
          "const": "reviewer",
          "type": "string"
        },
        {
          "const": "viewer",
          "type": "string"
        }
      ]
    },
    "targetEmailMasked": {
      "minLength": 3,
      "maxLength": 320,
      "type": "string"
    },
    "identityStatus": {
      "$id": "kanvas.invitation-identity-status.v1",
      "anyOf": [
        {
          "const": "signed_out",
          "type": "string"
        },
        {
          "const": "matched",
          "type": "string"
        },
        {
          "const": "mismatched",
          "type": "string"
        },
        {
          "const": "unverified",
          "type": "string"
        }
      ]
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
